# Halium 通用配置片段（最小集）
# 由本项目根据 Halium/libhybris 运行需求整理；设备特定项放在 droidian/<model>.config

# Android 兼容
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
# Halium 使用 /dev/binder 设备节点（而非 binderfs）
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_ASHMEM=y

# 文件系统 / 设备节点
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# 命名空间（容器 / LXC）
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# 网络
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_MACVLAN=y

# initramfs 解压
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_DECOMPRESS_LZ4=y
