# Droidian 通用配置片段（最小集）
# 设备特定项（USB gadget、dm-thin、firmware path 等）放在 droidian/<model>.config

# 控制台 / 虚拟终端
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# 用户态常用
CONFIG_FUSE_FS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_SECCOMP=y

# 安全模块
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y

# 常用文件系统
CONFIG_EXT4_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_F2FS_FS=y
