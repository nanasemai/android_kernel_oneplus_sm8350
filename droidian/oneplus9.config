# OnePlus 9 (lemonade / lahaina) 设备配置片段
# 说明：本片段在公共片段之后合并（后写入者生效）。
# 最终以 out/KERNEL_OBJ/.config 为准，不以本文件为准。

# --- USB gadget / 调试通道（首启关键） ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# --- Virtual A/B ---
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_SNAPSHOT=y

# --- Android 兼容（覆盖 defconfig 的 binderfs=y） ---
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDERFS is not set

# --- 设备节点 / 控制台 ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- 存储 / 内存 ---
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# --- 安全 ---
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y

# --- 固件加载路径（Android 11 vendor 布局） ---
CONFIG_EXTRA_FIRMWARE=""
CONFIG_FW_LOADER_USER_HELPER=y

# --- 网络 ---
CONFIG_MACVLAN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y

# --- 模块（vendor_boot ramdisk / udev 加载） ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
